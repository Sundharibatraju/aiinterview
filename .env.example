# Copy this file to .env and replace values with your own credentials.

# AI
GEMINI_API_KEY=

# Application
APP_URL=http://localhost:3000
NODE_ENV=development
DISABLE_HMR=false

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PostgreSQL / Neon
# Use the complete connection string from your provider. For Neon, use the pooled
# connection string and keep sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Session and authentication
SECRET_KEY=

# SMTP (optional; leave SMTP_USER and SMTP_PASS empty to disable email delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
